<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTitlu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestiune Apartamente"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnDeschideAdaugare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="deschideAdaugareClasic"
        android:text="Adauga Apartament (Formular Standard)"/>

    <Button
        android:id="@+id/btnDeschideAdaugareAi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:onClick="deschidereAdaugareAi"
        android:text="Adauga Apartament (Design AI Modern)"/>

    <TextView
        android:id="@+id/tvRezultatObiect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#F0F0F0"
        android:padding="16dp"
        android:text="Nici un apartament adaugat inca."
        android:textSize="16sp" />

</LinearLayout>